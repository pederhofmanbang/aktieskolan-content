{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 -X POST -H \"content-type: application/json\" -H \"Authorization: Bearer $VOICE_HUB_TOKEN\" -H \"X-Remote-Session: $CLAUDE_CODE_REMOTE_SESSION_ID\" --data-binary @- https://voice-hub.peder-hofman-bang.workers.dev/hook || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": [
              "VOICE_HUB_TOKEN",
              "CLAUDE_CODE_REMOTE_SESSION_ID"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": [
              "VOICE_HUB_TOKEN",
              "CLAUDE_CODE_REMOTE_SESSION_ID"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": [
              "VOICE_HUB_TOKEN",
              "CLAUDE_CODE_REMOTE_SESSION_ID"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cc-monitor.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
