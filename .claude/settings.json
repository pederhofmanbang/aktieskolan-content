{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": ["VOICE_HUB_TOKEN", "CLAUDE_CODE_REMOTE_SESSION_ID"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": ["VOICE_HUB_TOKEN", "CLAUDE_CODE_REMOTE_SESSION_ID"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": ["VOICE_HUB_TOKEN", "CLAUDE_CODE_REMOTE_SESSION_ID"]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "http",
            "url": "https://voice-hub.peder-hofman-bang.workers.dev/hook",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $VOICE_HUB_TOKEN",
              "X-Remote-Session": "$CLAUDE_CODE_REMOTE_SESSION_ID"
            },
            "allowedEnvVars": ["VOICE_HUB_TOKEN", "CLAUDE_CODE_REMOTE_SESSION_ID"]
          }
        ]
      }
    ]
  }
}
